# Copy to .env.local (or set in Vercel → Project → Settings → Environment Variables).
# Nothing here is required for a local run: `npm run dev` works with no env at all.

# ── storage (pick one; without it Vercel falls back to in-memory demo storage) ──
# Upstash Redis (Vercel Marketplace → Upstash → Redis sets these for you)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# or the older Vercel KV names (also Upstash under the hood)
KV_REST_API_URL=
KV_REST_API_TOKEN=
# local JSON file (default .data/db.json; ignored on Vercel)
DATA_FILE=

# ── engine ──
# protects GET /api/tick; Vercel Cron sends it automatically as "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=
TICK_EVERY_MS=60000
AUTO_TICK=true
STREAM_HOLD_MS=
MAX_AGENTS=200
MAX_AGENTS_PER_CREATOR=5
MAX_PAPER_CAPITAL_SOL=100

# ── site ──
SITE_URL=
X_URL=
CONTRACT_ADDRESS=
# only used by /api/blockhash (wallet flows) and the live module
SOLANA_RPC_URL=

# ── live trading: OFF. Not wired into the app yet (see README → Live trading). ──
LIVE_TRADING=false
# 32 bytes, e.g. `openssl rand -hex 32`. Never commit it. Losing it = losing the builder wallets.
WALLET_ENCRYPTION_KEY=

# ---------- Core ----------
# Public base URL (used for OAuth redirect URIs and media links). No trailing slash.
APP_URL=http://localhost:3000
# Postgres connection string. Leave empty locally to use the embedded PGlite database (in-memory).
DATABASE_URL=
# Optional: persist the embedded PGlite database to disk when DATABASE_URL is empty.
PGLITE_DATA_DIR=
# 32 random bytes, base64 or hex: `openssl rand -base64 32`. Encrypts OAuth tokens at rest. REQUIRED in production.
TOKEN_ENCRYPTION_KEY=
# Signs the wallet session cookie: `openssl rand -hex 32`. REQUIRED in production.
SESSION_SECRET=
# Bearer secret for /api/cron/* (Vercel Cron sends it automatically). REQUIRED in production.
CRON_SECRET=
# Global kill switch. Defaults to true: nothing is published until you set it to false.
DRY_RUN=true
# Optional per-platform overrides (fall back to DRY_RUN).
X_DRY_RUN=
TIKTOK_DRY_RUN=
INSTAGRAM_DRY_RUN=
# Enable /api/dev/seed and ?now= time travel on cron routes in production (don't).
ALLOW_DEV_ROUTES=false
# "Follow on X" link in the nav/footer.
NEXT_PUBLIC_X_URL=

# ---------- AI (persona + captions) ----------
# Without it, a deterministic template generator is used.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Set to false to keep Claude for personas but use templates for daily captions.
PLANNER_USE_CLAUDE=true

# ---------- Media generation ----------
# placeholder (free SVG art, DRY_RUN only) | fal. Defaults to fal when FAL_KEY is set.
MEDIA_PROVIDER=
FAL_KEY=
FAL_PORTRAIT_MODEL=fal-ai/flux/dev
FAL_IMAGE_MODEL=fal-ai/flux-pro/kontext
FAL_VIDEO_MODEL=fal-ai/kling-video/v2.1/standard/image-to-video

# ---------- Solana / launch ----------
# Server-side RPC (browser calls go through /api/rpc so a keyed RPC URL stays private).
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
PUMP_API_BASE=https://frontend-api-v3.pump.fun
DEXSCREENER_API_BASE=https://api.dexscreener.com
PUMP_IPFS_URL=https://pump.fun/api/ipfs
PUMPPORTAL_TRADE_LOCAL_URL=https://pumpportal.fun/api/trade-local
# Optional fallback IPFS pinning if pump.fun's upload endpoint is down.
PINATA_JWT=
# Non-pump.fun tokens count as graduated at this DEX liquidity (USD).
GRADUATION_MIN_DEX_LIQUIDITY_USD=10000

# ---------- X ----------
X_CLIENT_ID=
X_CLIENT_SECRET=
# Max posts per influencer per 24h on X (set to your API tier's per-user limit).
X_DAILY_CAP=17

# ---------- TikTok ----------
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Flip to true only after TikTok approves your Content Posting API audit.
TIKTOK_APP_AUDITED=false
# TikTok requires express user consent per upload; keep true.
TIKTOK_REQUIRE_APPROVAL=true
TIKTOK_DAILY_CAP=15

# ---------- Instagram (Instagram API with Instagram Login) ----------
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_GRAPH_VERSION=v23.0
# Flip to true after Meta App Review grants Advanced Access.
META_APP_REVIEWED=false
INSTAGRAM_DAILY_CAP=25

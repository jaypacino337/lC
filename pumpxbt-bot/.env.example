# ============================================================================
# PumpXBT bot — copy to .env and fill in. NEVER commit .env.
# On Railway these go in the service's Variables tab, not in a file.
# ============================================================================

# ── Mode ────────────────────────────────────────────────────────────────────
# paper = simulate every fill, touch no funds. live = real execution (NOT built).
PXBT_MODE=paper

# live | fixture. fixture replays test/fixtures so you can run with no network.
PXBT_SOURCE=fixture

# ── Helius ──────────────────────────────────────────────────────────────────
# Comma-separate as many keys as you have. The pool rotates on every request
# and parks a key for a cooldown when it returns 429, so more keys = more
# headroom. No key ever leaves this process.
HELIUS_KEYS=key1,key2,key3

# ── pump.fun ────────────────────────────────────────────────────────────────
# WARNING: these endpoints are UNVERIFIED — see src/sources/pumpfun.js.
# Confirm the real paths before running with PXBT_SOURCE=live.
PUMPFUN_API_BASE=https://frontend-api.pump.fun
PUMPFUN_CALLOUTS_PATH=/callouts
PUMPFUN_TRADES_PATH=/trades

# ── Economics (your numbers — verify against pump.fun's actual rules) ───────
# Probe buy placed purely to unlock a callout.
PROBE_BUY_USD=2
# Minimum position value to retain call eligibility. The exit logic treats this
# as a hard floor it may never sell through.
CALL_ELIGIBILITY_FLOOR_USD=1
# Conviction trades are sized separately from probes.
TRADE_MAX_USD=25
# Assumed round-trip cost: pump.fun fee + priority fee + slippage, in bps.
COST_BPS=180

# ── Risk ────────────────────────────────────────────────────────────────────
MAX_OPEN_POSITIONS=25
MAX_DAILY_DEPLOY_USD=250
# Paper starting balance. In live mode this would be the real wallet balance.
PAPER_START_USD=500

# ── Treasury (read-only display; the ledger API surfaces these) ─────────────
TREASURY_WALLET=

# ── X (Twitter) reply agent — `npm run x`, all optional ─────────────────────
# Reading mentions needs the app Bearer Token (any paid API tier).
X_BEARER_TOKEN=
# Posting replies needs the four user-context OAuth 1.0a keys, with the app set
# to Read+Write in the X developer portal. Leave blank to run in DRY-RUN:
# replies are composed and stored as drafts, nothing is ever sent.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
# The account the agent speaks as.
X_HANDLE=
X_USER_ID=
# Reply generation. With a key, Claude writes replies grounded in live bot
# state; without one, deterministic template replies are used instead.
ANTHROPIC_API_KEY=
X_REPLY_MODEL=claude-opus-5
# Politeness limits — hard caps enforced by the agent, not the prompt.
X_MAX_REPLIES_PER_15M=8
X_MAX_REPLIES_PER_USER_PER_DAY=3
X_POLL_INTERVAL_MS=90000

# ── Alerts (optional — leave blank to disable) ──────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Ledger API ──────────────────────────────────────────────────────────────
PORT=8080
# Comma-separated origins allowed to read the ledger. Your site's domain.
CORS_ORIGINS=http://localhost:8000,http://localhost:8123

# ── Loop ────────────────────────────────────────────────────────────────────
POLL_INTERVAL_MS=6000
DB_PATH=./data/pumpxbt.db
LOG_LEVEL=info

# Server-only. Never prefix these with NEXT_PUBLIC_.
SOLANA_RPC_URL=          # e.g. Helius mainnet URL; falls back to the public RPC (rate-limited)
PINATA_JWT=              # Pinata JWT with upload rights: IPFS for coin images + metadata

# Batch log: EITHER Supabase (Vercel/serverless; run supabase/schema.sql first)...
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# ...OR JSON files on a persistent disk (VPS / Railway volume). Default ./.data
SLUDGE_DATA_DIR=

# Public: the production origin, for absolute OG / canonical URLs
NEXT_PUBLIC_SITE_URL=
